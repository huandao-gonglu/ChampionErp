DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1

# 跨境巴士企业应用密钥，仅供开发者在后端配置；不得使用 VITE_ 前缀或随安装包分发。
ERP_CROSSBORDERBUS_CLIENT_SECRET=

# 后端日志。ERP_LOG_LEVEL 是控制台与文件的共同默认值；两个专用变量可覆盖它。
# 可用级别：DEBUG、INFO、WARNING、ERROR、CRITICAL。
ERP_LOG_LEVEL=INFO
ERP_LOG_CONSOLE_LEVEL=INFO
ERP_LOG_FILE_LEVEL=INFO
ERP_LOG_FILE=data/logs/backend.log
ERP_LOG_DATE_NAMED=1
ERP_LOG_MAX_BYTES=5242880
ERP_LOG_BACKUP_COUNT=5

# 图片托管在应用设置中配置，凭据仅保存到 SQLite runtime_secrets。

# 1688 服务商应用，仅供受控后端配置；客户通过官方登录完成买家授权。
# AppKey / AppSecret 必须成对配置。回调地址须与 1688 开发者后台登记一致。
# 不得使用 VITE_ 前缀或把公司 AppSecret 放进客户安装包。
ERP_ALIBABA_APP_KEY=
ERP_ALIBABA_APP_SECRET=
ERP_ALIBABA_REDIRECT_URI=

# 1688 跨境商品查询应用，单独连接买家账号
ERP_ALIBABA_CROSSBORDER_APP_KEY=
ERP_ALIBABA_CROSSBORDER_APP_SECRET=
ERP_ALIBABA_CROSSBORDER_REDIRECT_URI=

# 统一业务后端监听与可信请求来源；反向代理部署按真实站点设置。
ERP_BIND_HOST=127.0.0.1
ERP_PUBLIC_URL=
ERP_ALLOWED_HOSTS=
ERP_ALLOWED_ORIGINS=
