DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1

# 后端日志。ERP_LOG_LEVEL 是控制台与文件的共同默认值；两个专用变量可覆盖它。
# 可用级别：DEBUG、INFO、WARNING、ERROR、CRITICAL。
ERP_LOG_LEVEL=INFO
ERP_LOG_CONSOLE_LEVEL=INFO
ERP_LOG_FILE_LEVEL=INFO
ERP_LOG_FILE=data/logs/backend.log
ERP_LOG_DATE_NAMED=1
ERP_LOG_MAX_BYTES=5242880
ERP_LOG_BACKUP_COUNT=5

# 发布图片 HTTPS delivery。默认 existing_url 只接受图片池已有的公网 URL。
# 本地 Quick/Named Tunnel 使用 local_static；静态服务根目录必须与 ROOT 一致。
ERP_IMAGE_HTTPS_PROVIDER=existing_url
ERP_IMAGE_HTTPS_BASE_URL=
ERP_IMAGE_HTTPS_ROOT=data/images/public
# scripts/dev.sh 默认 auto：检测到 cloudflared 时自动创建 Quick Tunnel。
# required 表示启动失败时中止开发环境；off 表示完全禁用自动 Tunnel。
ERP_IMAGE_HTTPS_TUNNEL=auto
ERP_IMAGE_HTTPS_PORT=8787
