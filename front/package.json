{
  "name": "champion-erp-front",
  "productName": "gongluErp",
  "version": "1.2.191",
  "desktopUpdateOrigin": "https://hdgl.cc.cd",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "build:desktop": "vue-tsc -b && vite build --mode desktop",
    "desktop:dev": "vite --host 127.0.0.1 --strictPort --mode desktop-dev",
    "build:runtime": "python3 ../scripts/build_desktop_runtime.py",
    "desktop:pack": "pnpm build:runtime && pnpm build:desktop && electron-builder --dir",
    "desktop:dist": "pnpm build:runtime && pnpm build:desktop && electron-builder",
    "test:desktop": "node --test desktop/*.test.cjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "types:generate": "python3 ../scripts/generate_frontend_types.py",
    "types:check": "python3 ../scripts/generate_frontend_types.py --check",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/vue": "4.0.65",
    "@phosphor-icons/vue": "^2.2.1",
    "@vueuse/core": "^11.3.0",
    "ai": "7.0.65",
    "axios": "^1.16.1",
    "chart.js": "^4.5.1",
    "pinia": "^2.3.1",
    "vue": "^3.5.35",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.10",
    "autoprefixer": "^10.5.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^5.4.21",
    "vite-plugin-checker": "^0.8.0",
    "vitest": "^2.1.9",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.12"
  },
  "build": {
    "protocols": [
      {
        "name": "gongluErp",
        "schemes": [
          "champion-erp"
        ]
      }
    ],
    "extends": "./electron-builder.config.mjs",
    "appId": "com.champion.erp.front",
    "icon": "desktop/assets/icon.png",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "!desktop/**/*.test.cjs",
      "dist-desktop/**/*",
      "!dist-desktop/licenses/**/*",
      "!node_modules/**/*",
      "!**/node_modules/**/*",
      "package.json"
    ],
    "dmg": {
      "writeUpdateInfo": false
    },
    "extraResources": [
      {
        "from": ".desktop-runtime/champion-erp-runtime",
        "to": "runtime"
      },
      {
        "from": "dist-desktop/licenses",
        "to": "licenses"
      }
    ],
    "mac": {
      "icon": "desktop/assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
